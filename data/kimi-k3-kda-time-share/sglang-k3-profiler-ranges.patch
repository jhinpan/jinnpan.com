+# Opt-in profiler ranges around the cost centres of a K3 block (KDA /
+# full-attention / MoE). A torch profile can then attribute each GPU kernel to a
+# block type by correlation, instead of guessing from kernel names -- the Tensile
+# GEMM names encode tile shapes, not which projection they served, so a KDA
+# q_proj and a shared-expert GEMM are indistinguishable by name alone. Off unless
+# the env var is set, and then a no-op class rather than a hot-path branch.
+if get_bool_env_var("SGLANG_K3_PROF_RANGES"):
+    from torch.profiler import record_function as _prof_range
+else:
+
+    class _prof_range:
+        __slots__ = ()
+
+        def __init__(self, name: str) -> None:
+            pass
+
+        def __enter__(self) -> "_prof_range":
+            return self
+
+        def __exit__(self, *exc) -> bool:
+            return False
+
+
 # ---------------------------------------------------------------------------
 # Helpers
 # ---------------------------------------------------------------------------
