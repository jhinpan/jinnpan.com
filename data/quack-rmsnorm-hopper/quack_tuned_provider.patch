+class _QuackTunedProvider:
+    """Quack's autotuned CuTe RMSNorm, so the analytical ladder has a ceiling.
+
+    ``rmsnorm_fwd`` / ``rmsnorm_bwd`` pick a launch config from the hand-written
+    analytical heuristic; the ``_tuned`` entry points let ``@autotune`` search
+    the exhaustive config space instead. Those take preallocated outputs and,
+    for backward, stop at the fp32 partials, so this provider allocates and
+    finalizes exactly the way the un-tuned wrappers do internally. Otherwise
+    the two providers would not be timing the same work.
+
+    The first call per cell pays the whole config search. That lands in
+    ``cold_compile_ms``, which the harness records separately and excludes from
+    the steady-state samples.
+    """
+
+    def __init__(self, torch: Any):
+        self.torch = torch
+        module = importlib.import_module("quack.rmsnorm")
+        self._fwd_untuned = module.rmsnorm_fwd
+        self._fwd_tuned = module.rmsnorm_fwd_tuned
+        self._bwd_tuned = module.rmsnorm_bwd_tuned
+        self._sm_count = module.get_sm_count
+
+    def prepare(
+        self,
+        cell: MatrixCell,
+        inputs: dict[str, Any],
+        reference: tuple,
+        *,
+        eps: float,
+        rotation_buffers: int,
+    ) -> PreparedCase:
+        torch = self.torch
+        tensor_sets = []
+        calls = []
+        if cell.operation == "fwd":
+            for _ in range(rotation_buffers):
+                x = inputs["x"].clone()
+                weight = inputs["weight"].clone()
+                slot = [None]
+                tensor_sets.append(slot)
+
+                def call(x=x, weight=weight, slot=slot):
+                    out = torch.empty_like(x)
+                    self._fwd_tuned(x, weight, out, eps=eps)
+                    slot[0] = out
+
+                calls.append(call)
+            cold_start = time.perf_counter()
+            calls[0]()
+            torch.cuda.synchronize()
+            cold_compile_ms = (time.perf_counter() - cold_start) * 1000.0
+            _assert_correct(torch, cell, (tensor_sets[0][0],), reference)
+            return PreparedCase(
+                calls=calls,
+                reset=lambda: None,
+                outputs=lambda: (tensor_sets[0][0],),
+                provider_detail="quack.rmsnorm.rmsnorm_fwd_tuned (CuTe, autotuned)",
+                cold_compile_ms=cold_compile_ms,
+                cold_compile_reused=False,
+            )
+
+        sm_count = self._sm_count(cell.n, inputs["x"].device)
+        for _ in range(rotation_buffers):
+            x = inputs["x"].clone()
+            weight = inputs["weight"].clone()
+            dout = inputs["dout"].clone()
+            rstd = self._fwd_untuned(x, weight, eps=eps, store_rstd=True)[2]
+            slot = [None]
+            tensor_sets.append(slot)
+
+            def call(x=x, weight=weight, dout=dout, rstd=rstd, slot=slot):
+                dx = torch.empty_like(x)
+                dw_partial = torch.empty((sm_count, cell.n), device=x.device, dtype=torch.float32)
+                self._bwd_tuned(x, weight, dout, rstd, dx, dw_partial, has_dw_partial=True)
+                # rmsnorm_bwd folds this fp32 reduction in; keep it inside the
+                # timed region so both providers report the same operation.
+                slot[0] = (dx, dw_partial.sum(dim=0).to(weight.dtype))
+
+            calls.append(call)
+        torch.cuda.synchronize()
+        cold_start = time.perf_counter()
+        calls[0]()
+        torch.cuda.synchronize()
+        cold_compile_ms = (time.perf_counter() - cold_start) * 1000.0
+        _assert_correct(torch, cell, tensor_sets[0][0], reference[:2])
+        return PreparedCase(
+            calls=calls,
+            reset=lambda: None,
+            outputs=lambda: tensor_sets[0][0],
+            provider_detail="quack.rmsnorm.rmsnorm_bwd_tuned (CuTe, autotuned)",
+            cold_compile_ms=cold_compile_ms,
+            cold_compile_reused=False,
+        )
+
