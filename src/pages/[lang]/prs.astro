---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import PrSwimlanes from "@components/prs/PrSwimlanes.astro";
import { BOARD, IMPORTANCE, LANES, type Importance, type Lane, type Swimlane } from "@data/pr-board";
import type { Lang } from "@lib/utils";
import "@styles/prs.css";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const i18n = {
  en: {
    title: "PR board",
    description:
      "Open pull requests by Jin Pan in public repositories: what needs follow-up, what waits on his review, and what is in progress.",
    kicker: "PR board",
    refreshed: "Refreshed",
    heading: "Open pull requests",
    lead: "Every open pull request I wrote or was asked to review in a public repository, sorted by what it needs next. GitHub is the source. The board refreshes every night.",
    lanes: {
      "follow-up": "Needs follow-up",
      review: "Needs my review",
      "in-progress": "In progress",
    },
    laneNotes: {
      "follow-up": "Mine. The next move is mine.",
      review: "Someone else's. It waits on me.",
      "in-progress": "Mine. It waits on someone else.",
    },
    all: "All open",
    allNote: (repos: number) => `in ${repos} public repositories`,
    groupBy: "Group by",
    groupImportance: "Importance",
    groupRepo: "Repository",
    tiers: { high: "High", medium: "Medium", low: "Low" },
    tierHeading: (tier: string) => `${tier} importance`,
    tierMedium: "Other public repositories",
    rulesTitle: "How the board decides",
    rules: [
      {
        name: "Needs follow-up",
        text: `A pull request I opened, where one of these is true: a reviewer requested changes, CI fails, it has a merge conflict, it is approved but not merged, a reviewer spoke last, or nothing happened for ${BOARD.staleDays.ready} days (${BOARD.staleDays.draft} for a draft).`,
      },
      {
        name: "Needs my review",
        text: "A pull request by someone else, where my review is requested, or commits arrived after my last review and that review was not an approval.",
      },
      {
        name: "In progress",
        text: "Every other pull request I opened: a draft, or one that waits for reviewers or for CI.",
      },
      {
        name: "Importance",
        text: "A repository is high or low when src/data/pr-board.config.json lists it. Every other repository is medium. A single pull request can be pinned to a tier.",
      },
      {
        name: "Scope",
        text: "Public repositories only. Work in private repositories does not appear here.",
      },
    ],
  },
  zh: {
    title: "PR 看板",
    description: "Jin Pan 在公开仓库里的 open PR： 哪些需要跟进， 哪些等他 review， 哪些在进行中。",
    kicker: "PR 看板",
    refreshed: "刷新于",
    heading: "进行中的 Pull Request",
    lead: "我在公开仓库里提的、以及等我 review 的每一个 open PR， 按下一步该做什么排列。 数据来自 GitHub。 看板每晚刷新一次。",
    lanes: {
      "follow-up": "需要跟进",
      review: "等我 review",
      "in-progress": "进行中",
    },
    laneNotes: {
      "follow-up": "我提的。 下一步该我做。",
      review: "别人提的。 在等我。",
      "in-progress": "我提的。 在等别人。",
    },
    all: "全部",
    allNote: (repos: number) => `分布在 ${repos} 个公开仓库`,
    groupBy: "分组方式",
    groupImportance: "重要性",
    groupRepo: "仓库",
    tiers: { high: "高", medium: "中", low: "低" },
    tierHeading: (tier: string) => `重要性： ${tier}`,
    tierMedium: "其他公开仓库",
    rulesTitle: "看板的判定规则",
    rules: [
      {
        name: "需要跟进",
        text: `我提的 PR， 并且满足以下任一条： reviewer 要求修改， CI 失败， 有合并冲突， 已批准但未合并， 最后发言的是 reviewer， 或者 ${BOARD.staleDays.ready} 天没有动静（草稿是 ${BOARD.staleDays.draft} 天）。`,
      },
      {
        name: "等我 review",
        text: "别人提的 PR， 并且请求了我 review； 或者我上次 review 不是批准， 之后又有新的提交。",
      },
      {
        name: "进行中",
        text: "我提的其余 PR： 草稿， 或者在等 reviewer、等 CI。",
      },
      {
        name: "重要性",
        text: "src/data/pr-board.config.json 里列出的仓库是高或低。 其余仓库是中。 单个 PR 可以单独指定档位。",
      },
      {
        name: "范围",
        text: "只包含公开仓库。 私有仓库里的工作不会出现在这里。",
      },
    ],
  },
};

const t = i18n[lang];
const prs = BOARD.prs;
const total = (lane: Lane) => prs.filter((pr) => pr.lane === lane).length;
const repoNames = [...new Set(prs.map((pr) => pr.repo))];
const refreshedAt = `${BOARD.generatedAt.slice(0, 16).replace("T", " ")} UTC`;

const tierNotes: Record<Importance, string> = {
  high: (BOARD.importance.high ?? []).join(" · "),
  medium: t.tierMedium,
  low: (BOARD.importance.low ?? []).join(" · "),
};

const byImportance: Swimlane[] = IMPORTANCE.map((tier) => ({
  title: t.tierHeading(t.tiers[tier]),
  note: tierNotes[tier],
  open: tier !== "low",
  prs: prs.filter((pr) => pr.importance === tier),
})).filter((row) => row.prs.length > 0);

const rank = (tier: Importance) => IMPORTANCE.indexOf(tier);
const byRepo: Swimlane[] = repoNames
  .map((repo) => {
    const list = prs.filter((pr) => pr.repo === repo);
    // A pinned pull request can outrank its repository; the row takes the highest tier in it.
    const tier = IMPORTANCE[Math.min(...list.map((pr) => rank(pr.importance)))];
    return { title: repo, tier, open: tier !== "low", prs: list };
  })
  .sort((a, b) => rank(a.tier) - rank(b.tier) || b.prs.length - a.prs.length || a.title.localeCompare(b.title));
---

<Layout title={t.title} description={t.description} lang={lang}>
  <Container size="wide">
    <div class="prs" data-group="importance" data-lane="all" data-pagefind-ignore>
      <p class="prs-kicker animate">
        <span class="prs-dot" aria-hidden="true"></span>
        <b>{t.kicker}</b>
        <i aria-hidden="true">/</i>
        {t.refreshed}
        {refreshedAt}
      </p>
      <h1 class="prs-heading animate">{t.heading}</h1>
      <p class="prs-lead animate">{t.lead}</p>

      <div class="prs-summary animate">
        <div class="prs-stats">
          {
            LANES.map((lane) => (
              <button class="prs-stat" type="button" data-lane={lane} data-prs-set={`lane:${lane}`} aria-pressed="false">
                <b data-count={total(lane)}>{total(lane)}</b>
                <span>{t.lanes[lane]}</span>
                <small>{t.laneNotes[lane]}</small>
              </button>
            ))
          }
          <button class="prs-stat" type="button" data-lane="all" data-prs-set="lane:all" aria-pressed="true">
            <b data-count={prs.length}>{prs.length}</b>
            <span>{t.all}</span>
            <small>{t.allNote(repoNames.length)}</small>
          </button>
        </div>
        <div class="prs-mix" aria-hidden="true">
          {LANES.map((lane) => <i data-lane={lane} style={`flex-grow: ${total(lane)}`} />)}
        </div>
      </div>

      <div class="prs-controls animate">
        <span>{t.groupBy}</span>
        <div class="prs-segment" role="group" aria-label={t.groupBy}>
          <button type="button" data-prs-set="group:importance" aria-pressed="true">{t.groupImportance}</button>
          <button type="button" data-prs-set="group:repo" aria-pressed="false">{t.groupRepo}</button>
        </div>
      </div>

      <div class="prs-columns animate" aria-hidden="true">
        {
          LANES.map((lane) => (
            <div class="prs-column" data-lane={lane}>
              <b>{t.lanes[lane]}</b>
              <span>{t.laneNotes[lane]}</span>
            </div>
          ))
        }
      </div>

      <PrSwimlanes view="importance" rows={byImportance} lang={lang} laneLabels={t.lanes} tierLabels={t.tiers} />
      <PrSwimlanes view="repo" rows={byRepo} lang={lang} laneLabels={t.lanes} tierLabels={t.tiers} />

      <section class="prs-rules animate">
        <h2>{t.rulesTitle}</h2>
        <dl>
          {
            t.rules.map((rule) => (
              <div>
                <dt>{rule.name}</dt>
                <dd>{rule.text}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </Container>
</Layout>

<script>
  // One listener on the document keeps working across ClientRouter navigations.
  document.addEventListener("click", (event) => {
    const control = (event.target as Element).closest<HTMLElement>("[data-prs-set]");
    const board = control?.closest<HTMLElement>(".prs");
    if (!control || !board) return;

    const [name, value] = control.dataset.prsSet!.split(":");
    board.dataset[name] = value;
    board.querySelectorAll<HTMLElement>(`[data-prs-set^="${name}:"]`).forEach((other) => {
      other.setAttribute("aria-pressed", String(other.dataset.prsSet === control.dataset.prsSet));
    });
  });
</script>
