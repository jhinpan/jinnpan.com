---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { ABOUT, SOCIALS, SITE } from "@consts";
import { THREADS } from "@data/home";
import type { Lang } from "@lib/utils";
import "@styles/pages.css";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const i18n = {
  zh: {
    kicker: "关于",
    place: "AMD · AIG Codesign · San Jose",
    heading: "全栈的 ML systems： 从 RL 训练到硬件",
    intro: [
      "我是潘劲（Jin Pan）， 在 AMD 的 AIG Codesign 团队做 ML systems。",
      "我的工作覆盖整个栈： 模型怎么用 RL 训练、数据准备、推理， 到底层的 DSL、compiler、kernel， 再到硬件的 co-design。 我想解决的是跨越这些层的问题。",
    ],
    work: "我在做什么",
    workLink: "PR 看板",
    measure: "我怎么做测量",
    rules: [
      {
        title: "先复现基线",
        text: "做跨平台比较之前， 我先用作者自己的 commit 复现公开的数字。 基线配错了， 测出来的差距就没有意义。",
        link: "Experiment 005",
        href: "/sources/dsv41-gb300-vs-mi355x.html",
      },
      {
        title: "原始数据随文提交",
        text: "每个实验都带着它的 CSV、运行日志和完整命令一起提交。 之后别人可以核对这些数字， 也可以引用。",
        link: "GitHub 上的 data/",
        href: "https://github.com/jhinpan/jinnpan.com/tree/main/data",
      },
      {
        title: "写下没成功的部分",
        text: "和预期相反的结果也留在文章里。 Experiment 007 把每用户 decode 速度提高到两倍以上， 但仍然输给两个普通副本。",
        link: "Experiment 007",
        href: "/sources/glm53-pd-monokernel-mi355x.html",
      },
    ],
    path: "经历",
    stages: [
      { years: "2026 —", place: "AMD · AIG Codesign", detail: "RL systems、GPU kernel、LLM serving · San Jose" },
      { years: "2024 — 2026", place: "威斯康星大学麦迪逊分校", detail: "MS, Computer Sciences" },
      { years: "2022 — 2024", place: "密歇根大学", detail: "BSE, Computer Science Engineering" },
      { years: "2020 — 2024", place: "上海交通大学", detail: "BE, Electrical and Computer Engineering" },
    ],
    oss: "开源",
    ossText: "我现在主要给 SGLang、FlyDSL 和 AITER 提交代码， 更早参与过 slime、SpecForge 和 Awesome-ML-SYS-Tutorial。",
    ossLink: "全部项目",
    connect: "联系方式",
  },
  en: {
    kicker: "About",
    place: "AMD · AIG Codesign · San Jose",
    heading: "Full-stack ML systems, from RL training to hardware",
    intro: [
      "I'm Jin Pan. I work on ML systems on the AIG Codesign team at AMD.",
      "My work covers the whole stack: how a model is trained with RL, data preparation, inference, the DSL underneath, the compiler, the kernels, and hardware co-design. The problems I want to solve are the ones that cross those layers.",
    ],
    work: "What I work on",
    workLink: "PR board",
    measure: "How I measure",
    rules: [
      {
        title: "Reproduce the baseline first",
        text: "Before a cross-platform comparison, I reproduce the published numbers with the author's own commit. A gap against a misconfigured baseline means nothing.",
        link: "Experiment 005",
        href: "/sources/dsv41-gb300-vs-mi355x.html",
      },
      {
        title: "Commit the raw data",
        text: "Each experiment ships with its CSVs, run logs and exact commands. Anyone can check the numbers later, or cite them.",
        link: "data/ on GitHub",
        href: "https://github.com/jhinpan/jinnpan.com/tree/main/data",
      },
      {
        title: "Report what did not work",
        text: "A result that goes against the plan stays in the write-up. Experiment 007 more than doubles per-user decode speed and still loses to two plain replicas.",
        link: "Experiment 007",
        href: "/sources/glm53-pd-monokernel-mi355x.html",
      },
    ],
    path: "Path",
    stages: [
      { years: "2026 —", place: "AMD · AIG Codesign", detail: "RL systems, GPU kernels, LLM serving · San Jose" },
      { years: "2024 — 2026", place: "University of Wisconsin-Madison", detail: "MS, Computer Sciences" },
      { years: "2022 — 2024", place: "University of Michigan", detail: "BSE, Computer Science Engineering" },
      { years: "2020 — 2024", place: "Shanghai Jiao Tong University", detail: "BE, Electrical and Computer Engineering" },
    ],
    oss: "Open source",
    ossText: "Today I contribute mostly to SGLang, FlyDSL and AITER. Earlier I worked on slime, SpecForge and Awesome-ML-SYS-Tutorial.",
    ossLink: "All projects",
    connect: "Contact",
  },
};

const t = i18n[lang];
---

<Layout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION} lang={lang}>
  <Container size="wide">
    <div class="page" data-pagefind-ignore>
      <div class="about-intro">
        <div>
          <p class="page-kicker animate">
            <span class="page-dot" aria-hidden="true"></span>
            <b>{t.kicker}</b>
            <i aria-hidden="true">/</i>
            {t.place}
          </p>
          <h1 class="page-heading animate">{t.heading}</h1>
          {t.intro.map((paragraph) => <p class="page-lead animate">{paragraph}</p>)}
        </div>
        <img class="about-photo animate" src="/profile.jpg" alt="Jin Pan" width="168" height="168" />
      </div>

      <section class="page-sec">
        <div class="page-sec-head animate">
          <h2>{t.work}</h2>
          <a class="page-link" href={`/${lang}/prs`}>{t.workLink} &rarr;</a>
        </div>
        <div class="about-threads">
          {
            THREADS.map((thread) => (
              <div class="about-thread animate">
                <span>{thread.tag}</span>
                <h3>{thread.title[lang]}</h3>
                <p>{thread.body[lang]}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="page-sec">
        <div class="page-sec-head animate">
          <h2>{t.measure}</h2>
        </div>
        <div class="about-rules">
          {
            t.rules.map((rule, index) => (
              <div class="about-rule animate">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{rule.title}</h3>
                <p>{rule.text}</p>
                <a
                  class="page-link"
                  href={rule.href}
                  target={rule.href.startsWith("http") ? "_blank" : undefined}
                  rel={rule.href.startsWith("http") ? "noopener" : undefined}
                >
                  {rule.link} &rarr;
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <section class="page-sec">
        <div class="page-sec-head animate">
          <h2>{t.path}</h2>
        </div>
        <ol class="about-timeline">
          {
            t.stages.map((stage) => (
              <li class="animate">
                <time>{stage.years}</time>
                <div>
                  <b>{stage.place}</b>
                  <span>{stage.detail}</span>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="page-sec">
        <div class="page-sec-head animate">
          <h2>{t.oss}</h2>
          <a class="page-link" href={`/${lang}/projects`}>{t.ossLink} &rarr;</a>
        </div>
        <p class="page-lead animate">{t.ossText}</p>
      </section>

      <section class="page-sec">
        <div class="page-sec-head animate">
          <h2>{t.connect}</h2>
        </div>
        <div class="about-contact animate">
          {
            SOCIALS.map((SOCIAL) => (
              <a class="page-link" href={SOCIAL.HREF} target="_blank" rel="noopener" aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME} &nearr;
              </a>
            ))
          }
          <a class="page-link" href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.TITLE}`}>
            {SITE.EMAIL}
          </a>
        </div>
      </section>
    </div>
  </Container>
</Layout>
