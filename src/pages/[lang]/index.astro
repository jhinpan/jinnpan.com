---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import StackFigure from "@components/home/StackFigure.astro";
import SectionHead from "@components/home/SectionHead.astro";
import { HOME, SOCIALS } from "@consts";
import { AS_OF, STATS, MEASUREMENTS, THREADS, LATEST, TIMELINE } from "@data/home";
import { BOARD_DATE } from "@data/pr-board";
import type { Lang } from "@lib/utils";
import "@styles/home.css";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const i18n = {
  en: {
    role: "ML Systems",
    headline: [["I make large"], ["models run fast"], ["on ", "AMD GPUs."]],
    lead: "I work across the full stack, from RL training to LLM serving. GPU kernels are the bridge between the two. I write them in FlyDSL, and I build the pipeline that lets agents write them too.",
    ctaLibrary: "Read the experiments",
    ctaAbout: "About me",
    stackTitle: "The stack I work on: training, serving, DSL, compiler, kernel, hardware",
    stackCaption:
      "Fig. 1 · The stack I work on, from RL training to hardware co-design. Each layer links to a reading.",
    asOf: `Library counts as of ${AS_OF}. Pull request counts as of ${BOARD_DATE}.`,
    measureTitle: "Selected measurements",
    measureDesc:
      "Each card opens the full write-up: the method, the raw data, and what did not work.",
    measureMore: "All experiments",
    threadsTitle: "What I work on",
    threadsDesc:
      "Four threads. Training and serving meet at the kernels. The number on a chip is merged pull requests.",
    threadsMore: "PR board",
    latestTitle: "Latest from the Library",
    latestDesc: "Code readings, paper readings, tutorials and experiments. In English and 中文.",
    latestMore: "All entries",
    aboutTitle: "About",
    aboutMore: "More",
    about: [
      "I work on ML systems across the full stack: how a model is trained with RL, data preparation, inference, the DSL underneath, the compiler, the kernels, and hardware co-design.",
      "The problems I want to solve are the ones that cross those layers.",
    ],
  },
  zh: {
    role: "ML Systems",
    headline: [["让大模型"], ["在 ", "AMD GPU", " 上"], ["跑得更快。"]],
    lead: "我做全栈： 从 RL 训练到 LLM serving。 GPU kernel 是训练和推理之间的桥。 我用 FlyDSL 写 kernel， 也在搭一条让 agent 写 kernel 的 pipeline。",
    ctaLibrary: "看实验记录",
    ctaAbout: "关于我",
    stackTitle: "我工作的软件栈： training、serving、DSL、compiler、kernel、hardware",
    stackCaption: "图 1 · 我工作的软件栈： 从 RL 训练到硬件 co-design。 每一层都链接到一篇精读。",
    asOf: `Library 数字截至 ${AS_OF}； PR 数字截至 ${BOARD_DATE}。`,
    measureTitle: "精选测量",
    measureDesc: "每张卡片都通向完整记录： 方法、原始数据， 以及没有成功的部分。",
    measureMore: "全部实验",
    threadsTitle: "我在做什么",
    threadsDesc: "四条线。 训练和推理在 kernel 这一层交汇。 标签上的数字是 merged PR 数。",
    threadsMore: "PR 看板",
    latestTitle: "Library 最新内容",
    latestDesc: "代码精读、论文精读、教程和实验。 中英双语。",
    latestMore: "全部条目",
    aboutTitle: "关于",
    aboutMore: "更多",
    about: [
      "我做全栈的 ML systems： 从模型怎么用 RL 训练、数据准备、推理， 到底层的 DSL、compiler、kernel， 再到硬件的 co-design。",
      "我想解决的是跨越这些层的全栈问题。",
    ],
  },
};

const t = i18n[lang];

// The accent phrase is the second part of a two-part line, or the middle of a three-part line.
const accentIndex = 1;

const posts = await getCollection("blog");
const latest = LATEST.map((item) => {
  if (item.kind === "source") return item;
  const post = posts.find((entry) => entry.id === `${lang}/${item.slug}`);
  if (!post) throw new Error(`LATEST in src/data/home.ts: no ${lang} blog post "${item.slug}"`);
  return {
    ...item,
    date: post.data.date.toISOString().slice(0, 10),
    title: post.data.title,
    href: `/${lang}/blog/${item.slug}/`,
  };
});
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION} lang={lang} bareTitle>
  <div class="home" data-pagefind-ignore>
    <section class="home-hero">
      <Container size="wide">
        <div class="home-hero-grid">
          <div>
            <p class="home-kicker animate">
              <span class="home-dot" aria-hidden="true"></span>
              <b>Jin Pan · 潘劲</b>
              <i aria-hidden="true">/</i>
              {t.role}
              <i aria-hidden="true">/</i>
              AMD · San Jose
            </p>
            <h1 class="home-display" data-reveal>
              {
                t.headline.map((parts, index) => (
                  <span class="home-line">
                    <span style={`--i: ${index}`}>
                      {parts.map((part, partIndex) =>
                        parts.length > 1 && partIndex === accentIndex ? <em>{part}</em> : part,
                      )}
                    </span>
                  </span>
                ))
              }
            </h1>
            <p class="home-lead animate">{t.lead}</p>
            <p class="home-cta animate">
              <a class="home-btn home-btn-primary" href="/sources/">
                {t.ctaLibrary} <span aria-hidden="true">&rarr;</span>
              </a>
              <a class="home-btn" href={`/${lang}/about`}>{t.ctaAbout}</a>
              {
                SOCIALS.map((SOCIAL) => (
                  <a class="home-tlink" href={SOCIAL.HREF} target="_blank" rel="noopener">
                    {SOCIAL.NAME}
                  </a>
                ))
              }
            </p>
          </div>
          <figure class="home-stack" data-reveal>
            <StackFigure title={t.stackTitle} lang={lang} />
            <figcaption>{t.stackCaption}</figcaption>
          </figure>
        </div>
      </Container>
    </section>

    <Container size="wide">
      <div class="animate">
        <div class="home-stats">
          {
            STATS.map((stat) => (
              <div class="home-stat">
                <b data-count={stat.value}>{stat.value}</b>
                <span>{stat.label[lang]}</span>
              </div>
            ))
          }
        </div>
        <p class="home-asof">{t.asOf}</p>
      </div>

      <section class="home-sec" id="work">
        <SectionHead
          no="01"
          title={t.measureTitle}
          desc={t.measureDesc}
          href="/sources/"
          more={t.measureMore}
        />
        <div class="home-cards">
          {
            MEASUREMENTS.map((item) => (
              <div class="animate">
                <a class="home-card" href={item.href}>
                  <div class="home-card-meta">
                    <span>{item.kicker}</span>
                    <span>{item.model}</span>
                  </div>
                  <h3>{item.title}</h3>
                  <div class="home-plate">
                    {item.rows.map((row, rowIndex) => (
                      <div class="home-row">
                        <span>{row.label[lang]}</span>
                        <span class="home-track">
                          {row.bars.map((bar) => (
                            <i
                              class={`home-fill home-fill-${bar.tone}`}
                              style={`--w: ${bar.width}%; --j: ${rowIndex}`}
                            />
                          ))}
                        </span>
                        <span class="home-row-value">{row.value}</span>
                      </div>
                    ))}
                    <p class="home-note">
                      {item.note[lang]} <b>{item.takeaway[lang]}</b>
                    </p>
                  </div>
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <section class="home-sec">
        <SectionHead
          no="02"
          title={t.threadsTitle}
          desc={t.threadsDesc}
          href={`/${lang}/prs`}
          more={t.threadsMore}
        />
        <div class="home-threads">
          {
            THREADS.map((thread) => (
              <div class="animate">
                <div class="home-thread">
                  <span class="home-thread-tag">{thread.tag}</span>
                  <h3>{thread.title[lang]}</h3>
                  <p>{thread.body[lang]}</p>
                  <div class="home-chips">
                    {thread.chips.map((chip) =>
                      chip.href ? (
                        <a
                          class="home-chip"
                          href={chip.href.replace("{lang}", lang)}
                          target={chip.href.startsWith("http") ? "_blank" : undefined}
                          rel={chip.href.startsWith("http") ? "noopener" : undefined}
                        >
                          {chip.label[lang]}
                          {chip.count !== undefined && <b>{chip.count}</b>}
                        </a>
                      ) : (
                        <span class="home-chip">{chip.label[lang]}</span>
                      ),
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="home-sec">
        <SectionHead
          no="03"
          title={t.latestTitle}
          desc={t.latestDesc}
          href="/sources/"
          more={t.latestMore}
        />
        <div class="home-rows">
          {
            latest.map((item) => (
              <div class="animate">
                <a class="home-rowlink" href={item.href}>
                  <time datetime={item.date}>{item.date}</time>
                  <span class="home-shelf" style={`--shelf: var(--shelf-${item.shelf})`}>
                    {item.label}
                  </span>
                  <span class="home-rowlink-title">{item.title}</span>
                  <span class="home-rowlink-go" aria-hidden="true">
                    &rarr;
                  </span>
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <section class="home-sec">
        <SectionHead no="04" title={t.aboutTitle} href={`/${lang}/about`} more={t.aboutMore} />
        <div class="home-about">
          <div class="animate">
            {t.about.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <ol class="home-timeline" data-reveal>
            {
              TIMELINE.map((stage, index) => (
                <li style={`--j: ${index}`}>
                  <b>{stage.year}</b>
                  <span>{stage.place[lang]}</span>
                  <small>{stage.detail}</small>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
    </Container>
  </div>
</Layout>
