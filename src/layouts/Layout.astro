---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  lang?: "zh" | "en";
  // Use `title` as the whole document title instead of "<title> | <site title>".
  bareTitle?: boolean;
};

const { title, description, lang = "en", bareTitle = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={bareTitle ? title : `${title} | ${SITE.TITLE}`}
      description={description}
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <Pagefind />
    <script is:inline>
      // Mermaid is about 730 KB over the wire, so fetch it only for pages with a .mermaid block.
      function renderMermaid() {
        if (!document.querySelector(".mermaid")) return;
        if (window.mermaid) {
          window.mermaid.run();
          return;
        }
        const script = document.createElement("script");
        script.src = "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js";
        script.onload = () => {
          window.mermaid.initialize({ startOnLoad: false, theme: "default" });
          window.mermaid.run();
        };
        document.head.appendChild(script);
      }

      document.addEventListener("DOMContentLoaded", renderMermaid);
      document.addEventListener("astro:after-swap", renderMermaid);
    </script>
  </body>
</html>
